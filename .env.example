# Copy to .env.local and adjust. Every variable the application reads is listed
# here; it is validated by src/lib/config/env.ts at build time.

# Which content repository backs dynamic surfaces: mock | api
CONTENT_SOURCE=mock

# Spring Boot gateway. Required when CONTENT_SOURCE=api. Never NEXT_PUBLIC_ —
# the browser must not see it.
API_BASE_URL=

# Timeout applied to backend calls, in milliseconds.
API_TIMEOUT_MS=8000

# Azure Blob container serving investor PDFs and news imagery.
# e.g. https://<account>.blob.core.windows.net/public
AZURE_BLOB_BASE_URL=

# Canonical public origin. Drives metadataBase, sitemap and canonical URLs.
NEXT_PUBLIC_SITE_URL=https://www.sael.co

# Oracle recruiting system. /career/ 404s until this is set — client to confirm.
CAREER_REDIRECT_URL=

# Artificial delay on mock repository reads, for testing loading states.
MOCK_LATENCY_MS=0
